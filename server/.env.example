# ====================================================================
# HireTrack Backend Environment Configuration
# Copy this file to .env and replace the values with your local settings.
# ====================================================================

# Express Server Port
PORT=5000

# Frontend URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hiretrack

# JSON Web Token Secret & Expiration
JWT_SECRET=super_secret_hiretrack_key_replace_in_production
JWT_EXPIRES_IN=7d
